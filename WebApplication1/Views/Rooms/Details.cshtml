@model WebApplication1.Models.Room
@{
    ViewData["Title"] = "Chi tiết phòng";
}

<div class="container-fluid mt-2">
    <!-- Tiêu đề và Nút quay lại -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary mb-0">
            <i class="fa-solid fa-circle-info me-2"></i>Chi tiết Phòng
        </h3>
        <a asp-action="Index" class="btn btn-light border rounded-pill px-4 shadow-sm fw-bold text-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>Quay lại danh sách
        </a>
    </div>

    <!-- Khối hiển thị thông tin -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4 p-md-5">
            <!-- Đổi thành 3 cột (col-md-4) để dàn đều trên 1 hàng ngang -->
            <div class="row mb-2">
                <div class="col-md-4 mb-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-3">
                        <i class="fa-solid fa-signature me-2"></i>Tên phòng
                    </h6>
                    <!-- Đã bỏ ps-4 để thẳng lề với icon -->
                    <h4 class="fw-bold text-dark">@Model.Name</h4>
                </div>

                <div class="col-md-4 mb-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-3">
                        <i class="fa-solid fa-tag me-2"></i>Loại phòng
                    </h6>
                    <div>
                        <span class="badge bg-secondary rounded-pill px-3 py-2 fs-6 shadow-sm">@Model.RoomType</span>
                    </div>
                </div>

                <div class="col-md-4 mb-4">
                    <h6 class="text-muted text-uppercase fw-bold mb-3">
                        <i class="fa-solid fa-users me-2"></i>Sức chứa
                    </h6>
                    <div>
                        <span class="badge bg-light text-secondary border rounded-pill px-3 py-2 fs-6 shadow-sm">
                            @Model.Capacity người
                        </span>
                    </div>
                </div>
            </div>

            <!-- Vùng chuẩn bị cho Danh sách Thiết bị -->
            <hr class="mb-4 mt-0 text-muted" />
            <div class="row mb-4">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-muted text-uppercase fw-bold mb-0">
                            <i class="fa-solid fa-plug me-2"></i>Thiết bị trong phòng
                        </h6>
                        <!-- Nút mồi để nhảy sang trang Tạo thiết bị mới, truyền sẵn RoomId -->
                        <a asp-controller="Facilities" asp-action="Create" asp-route-RoomId="@Model.Id" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm fw-bold">
                            <i class="fa-solid fa-plus me-1"></i>Thêm thiết bị
                        </a>
                    </div>

                    @if (Model.Facilities != null && Model.Facilities.Any())
                    {
                        <div class="table-responsive bg-white rounded-4 shadow-sm border p-0">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="px-4 py-3 text-muted fs-7 text-uppercase">Tên thiết bị</th>
                                        <th class="py-3 text-muted fs-7 text-uppercase">Mô tả</th>
                                        <th class="py-3 text-center text-muted fs-7 text-uppercase">Số lượng</th>
                                        <th class="py-3 text-center text-muted fs-7 text-uppercase">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fac in Model.Facilities)
                                    {
                                        <tr>
                                            <td class="px-4 fw-bold text-dark">@fac.Name</td>
                                            <td class="text-muted text-truncate" style="max-width: 250px;">@fac.Description</td>
                                            <td class="text-center">
                                                <span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill px-3 py-1 fs-6">
                                                    @fac.Quantity
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <a asp-controller="Facilities" asp-action="Edit" asp-route-id="@fac.Id" class="btn btn-sm btn-light border rounded-circle text-warning me-1 shadow-sm" title="Sửa">
                                                    <i class="fa-solid fa-pen"></i>
                                                </a>
                                                <a asp-controller="Facilities" asp-action="Delete" asp-route-id="@fac.Id" class="btn btn-sm btn-light border rounded-circle text-danger shadow-sm" title="Xóa">
                                                    <i class="fa-solid fa-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 bg-light rounded-4 border text-center text-muted fst-italic">
                            Chưa có thiết bị nào được gán cho phòng này.
                        </div>
                    }
                </div>
            </div>
    </div>
</div>