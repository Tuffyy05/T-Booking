@model WebApplication1.Models.Room

@{
    ViewData["Title"] = "Sửa thông tin phòng";
}

<h2 class="mt-4 mb-4">Sửa thông tin phòng học / Thiết bị</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <!-- Các trường ẩn bắt buộc -->
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Version" />

            <!-- Hiển thị thông báo lỗi ngầm (nếu có) -->
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Tên phòng <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Capacity" class="form-label">Sức chứa (Số người) <span class="text-danger">*</span></label>
                <input asp-for="Capacity" class="form-control" type="number" min="1" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RoomType" class="form-label">Loại phòng <span class="text-danger">*</span></label>
                <select asp-for="RoomType" class="form-select">
                    <option value="Lab">Phòng Thực hành (Lab)</option>
                    <option value="Meeting">Phòng Họp</option>
                    <option value="Hall">Hội trường</option>
                </select>
                <span asp-validation-for="RoomType" class="text-danger"></span>
            </div>

            <div class="mb-3 mt-4">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
            </div>
        </form>
    </div>
</div>