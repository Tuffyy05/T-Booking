@model IEnumerable<WebApplication1.Models.Room>
@{
    ViewData["Title"] = "Quản lý Phòng";
}

<div class="container-fluid mt-2">
    <!-- Tiêu đề và Nút thêm mới -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary mb-0">
            <i class="fa-solid fa-layer-group me-2"></i>Danh sách Phòng học & Thiết bị
        </h3>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
            <i class="fa-solid fa-plus me-2"></i>Tạo phòng mới
        </a>
    </div>

    <!-- Bảng danh sách trong khối Card -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3 text-uppercase fs-7 text-muted">Tên phòng</th>
                            <th class="py-3 text-uppercase fs-7 text-muted">Sức chứa (Người)</th>
                            <th class="py-3 text-uppercase fs-7 text-muted">Loại phòng</th>
                            <th class="py-3 text-center text-uppercase fs-7 text-muted">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 fw-bold text-dark fs-5">@item.Name</td>
                                <td>
                                    <!-- Nền xám nhạt, chữ xám đậm -->
                                    <span class="badge bg-light text-secondary border rounded-pill px-3 py-2">
                                        <i class="fa-solid fa-users me-1"></i> @item.Capacity
                                    </span>
                                </td>
                                <td>
                                    <!-- Đổi sang màu xám đậm dịu mắt -->
                                    <span class="badge bg-secondary rounded-pill px-3 py-2">
                                        @item.RoomType
                                    </span>
                                </td>
                                <td class="text-center">
                                    <!-- Nút xám nhạt, chữ đen, chỉ tô màu Icon -->
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-pill px-3 me-1 text-dark shadow-sm">
                                        <i class="fa-solid fa-pen text-warning me-1"></i>Sửa
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-pill px-3 me-1 text-dark shadow-sm">
                                        <i class="fa-solid fa-circle-info text-primary me-1"></i>Chi tiết
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-pill px-3 text-dark shadow-sm">
                                        <i class="fa-solid fa-trash text-danger me-1"></i>Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>