@model WebApplication1.Models.UserManagementViewModel
@{
    ViewData["Title"] = "Phân Quyền & Quản Lý Người Dùng";
    var currentAdmin = User.Identity?.Name;
}

<div class="container-fluid mt-2">
    <!-- TIÊU ĐỀ & NÚT THÊM TÀI KHOẢN -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="fa-solid fa-user-shield me-2"></i>Phân Quyền & Quản Lý Người Dùng
            </h3>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">
                Quản lý danh sách tài khoản, phân bổ vai trò quyền hạn và quản trị bảo mật hệ thống.
            </p>
        </div>
        <div>
            <button type="button" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#createUserModal">
                <i class="fa-solid fa-user-plus me-2"></i>Thêm tài khoản mới
            </button>
        </div>
    </div>

    <!-- KHỐI THỐNG KÊ (STAT CARDS) -->
    <div class="row g-3 mb-4">
        <!-- Tổng người dùng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%); border-left: 4px solid #0d6efd !important;">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; background-color: #dbeafe; color: #1d4ed8;">
                        <i class="fa-solid fa-users fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Tổng người dùng</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalUsers</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quản trị viên (Admin) -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: linear-gradient(135deg, #fef2f2 0%, #ffffff 100%); border-left: 4px solid #ef4444 !important;">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; background-color: #fee2e2; color: #b91c1c;">
                        <i class="fa-solid fa-shield-halved fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Quản trị viên (Admin)</span>
                        <h3 class="fw-bold text-danger mb-0 mt-1">@Model.AdminCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Khách hàng (Customer) -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: linear-gradient(135deg, #ecfdf5 0%, #ffffff 100%); border-left: 4px solid #10b981 !important;">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; background-color: #d1fae5; color: #047857;">
                        <i class="fa-solid fa-user-check fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Khách hàng (Customer)</span>
                        <h3 class="fw-bold text-success mb-0 mt-1">@Model.CustomerCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quản lý (Manager) -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: linear-gradient(135deg, #fffbeb 0%, #ffffff 100%); border-left: 4px solid #f59e0b !important;">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; background-color: #fef3c7; color: #b45309;">
                        <i class="fa-solid fa-user-tie fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Quản lý (Manager)</span>
                        <h3 class="fw-bold text-warning mb-0 mt-1">@Model.ManagerCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KHỐI TÌM KIẾM & BỘ LỌC -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0 text-muted ps-3">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" name="searchString" value="@Model.SearchString" class="form-control bg-light border-0 py-2" placeholder="Tìm theo tên đăng nhập hoặc email..." />
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0 text-muted ps-3">
                        <i class="fa-solid fa-filter"></i>
                    </span>
                    <select name="roleFilter" class="form-select bg-light border-0 py-2">
                        <option value="All" selected="@(Model.RoleFilter == "All")">-- Tất cả vai trò --</option>
                        <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Quản trị viên (Admin)</option>
                        <option value="Manager" selected="@(Model.RoleFilter == "Manager")">Quản lý (Manager)</option>
                        <option value="Customer" selected="@(Model.RoleFilter == "Customer")">Khách hàng (Customer)</option>
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4 flex-grow-1 fw-semibold">
                    <i class="fa-solid fa-filter me-1"></i>Lọc
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchString) || (Model.RoleFilter != "All" && !string.IsNullOrEmpty(Model.RoleFilter)))
                {
                    <a asp-action="Index" class="btn btn-light border rounded-pill px-3 text-secondary" title="Đặt lại bộ lọc">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- BẢNG DANH SÁCH NGƯỜI DÙNG & PHÂN QUYỀN -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark fs-6">
                <i class="fa-solid fa-table-list text-primary me-2"></i>Danh sách người dùng (@Model.Users.Count)
            </span>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2 small fw-semibold">
                <i class="fa-solid fa-shield-halved me-1"></i>Hệ thống giới hạn duy nhất 1 Quản trị viên (Admin)
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3 text-uppercase fs-7 text-muted" style="width: 70px;">ID</th>
                            <th class="py-3 text-uppercase fs-7 text-muted">Người dùng</th>
                            <th class="py-3 text-uppercase fs-7 text-muted">Email</th>
                            <th class="py-3 text-uppercase fs-7 text-muted text-center" style="width: 160px;">Vai trò</th>
                            <th class="py-3 text-uppercase fs-7 text-muted text-center" style="width: 240px;">Phân quyền nhanh</th>
                            <th class="py-3 text-uppercase fs-7 text-muted text-center" style="width: 200px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fa-regular fa-folder-open fs-1 text-secondary opacity-50 mb-3 d-block"></i>
                                    Không tìm thấy người dùng nào phù hợp với điều kiện tìm kiếm.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in Model.Users)
                            {
                                var isSelf = user.Username.Equals(currentAdmin, StringComparison.OrdinalIgnoreCase);
                                <tr>
                                    <!-- ID -->
                                    <td class="px-4 fw-bold text-muted">
                                        #@user.Id
                                    </td>

                                    <!-- TÊN NGƯỜI DÙNG -->
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3 fw-bold text-white shadow-sm"
                                                 style="width: 40px; height: 40px; background: @(user.Role == "Admin" ? "linear-gradient(135deg, #ef4444, #b91c1c)" : (user.Role == "Manager" ? "linear-gradient(135deg, #f59e0b, #d97706)" : "linear-gradient(135deg, #3b82f6, #1d4ed8)"));">
                                                @(string.IsNullOrEmpty(user.Username) ? "U" : user.Username.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                                    @user.Username
                                                    @if (isSelf)
                                                    {
                                                        <span class="badge bg-primary rounded-pill px-2 py-1" style="font-size: 0.7rem;">Bạn</span>
                                                    }
                                                </div>
                                                <small class="text-muted">ID: @user.Id</small>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- EMAIL -->
                                    <td>
                                        <span class="text-dark">
                                            <i class="fa-regular fa-envelope text-muted me-1"></i>@user.Email
                                        </span>
                                    </td>

                                    <!-- VAI TRÒ HIỆN TẠI -->
                                    <td class="text-center">
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge rounded-pill px-3 py-2" style="background-color: #fee2e2; color: #b91c1c; border: 1px solid #fecaca;">
                                                <i class="fa-solid fa-shield-halved me-1"></i> Quản trị viên
                                            </span>
                                        }
                                        else if (user.Role == "Manager")
                                        {
                                            <span class="badge rounded-pill px-3 py-2" style="background-color: #fef3c7; color: #b45309; border: 1px solid #fde68a;">
                                                <i class="fa-solid fa-user-tie me-1"></i> Quản lý
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill px-3 py-2" style="background-color: #ecfdf5; color: #047857; border: 1px solid #a7f3d0;">
                                                <i class="fa-solid fa-user me-1"></i> Khách hàng
                                            </span>
                                        }
                                    </td>

                                    <!-- FORM PHÂN QUYỀN NHANH -->
                                    <td class="text-center">
                                        @if (isSelf)
                                        {
                                            <span class="text-muted small fst-italic">
                                                <i class="fa-solid fa-lock me-1"></i>Đang đăng nhập
                                            </span>
                                        }
                                        else
                                        {
                                            <form asp-action="UpdateRole" method="post" class="d-inline-flex align-items-center gap-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <select name="newRole" class="form-select form-select-sm rounded-pill border py-1 ps-3" style="width: 140px; font-size: 0.85rem;">
                                                    @if (user.Role == "Admin")
                                                    {
                                                        <option value="Admin" selected>Admin</option>
                                                    }
                                                    <option value="Customer" selected="@(user.Role == "Customer")">Customer</option>
                                                    <option value="Manager" selected="@(user.Role == "Manager")">Manager</option>
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1" title="Lưu phân quyền mới">
                                                    <i class="fa-solid fa-check"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>

                                    <!-- HÀNH ĐỘNG: ĐỔI MẬT KHẨU / XÓA -->
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1">
                                            <!-- Nút Đặt lại mật khẩu -->
                                            <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 text-dark shadow-sm"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#resetPasswordModal"
                                                    data-user-id="@user.Id"
                                                    data-username="@user.Username"
                                                    title="Đặt lại mật khẩu">
                                                <i class="fa-solid fa-key text-warning me-1"></i>Mật khẩu
                                            </button>

                                            <!-- Nút Xóa tài khoản -->
                                            @if (isSelf)
                                            {
                                                <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 text-muted shadow-sm" disabled title="Không thể xóa tài khoản của chính mình">
                                                    <i class="fa-solid fa-trash text-muted me-1"></i>Xóa
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 text-dark shadow-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteUserModal"
                                                        data-user-id="@user.Id"
                                                        data-username="@user.Username"
                                                        title="Xóa người dùng">
                                                    <i class="fa-solid fa-trash text-danger me-1"></i>Xóa
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================= -->
<!-- MODAL 1: THÊM TÀI KHOẢN MỚI                                   -->
<!-- ============================================================= -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-primary" id="createUserModalLabel">
                    <i class="fa-solid fa-user-plus me-2"></i>Thêm Tài Khoản Mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateUser" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Tên đăng nhập <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-user text-muted"></i></span>
                            <input type="text" name="username" class="form-control bg-light border-start-0" placeholder="Ví dụ: staff01" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Địa chỉ Email <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                            <input type="email" name="email" class="form-control bg-light border-start-0" placeholder="staff@huflit.edu.vn" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Mật khẩu ban đầu <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input type="password" name="password" minlength="6" class="form-control bg-light border-start-0" placeholder="Ít nhất 6 ký tự" required />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold text-secondary small">Phân quyền vai trò <span class="text-danger">*</span></label>
                        <select name="role" class="form-select bg-light">
                            <option value="Customer">Khách hàng (Customer) - Đặt phòng & thiết bị</option>
                            <option value="Manager">Quản lý (Manager) - Xem & xử lý điều phối</option>
                            @if (Model.AdminCount == 0)
                            {
                                <option value="Admin">Quản trị viên (Admin) - Toàn quyền hệ thống</option>
                            }
                        </select>
                        <small class="text-muted d-block mt-1">
                            <i class="fa-solid fa-circle-info text-primary me-1"></i>Hệ thống chỉ cho phép duy nhất 1 tài khoản Quản trị viên (Admin).
                        </small>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="fa-solid fa-check me-1"></i>Tạo tài khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================= -->
<!-- MODAL 2: ĐẶT LẠI MẬT KHẨU                                     -->
<!-- ============================================================= -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="resetPasswordModalLabel">
                    <i class="fa-solid fa-key text-warning me-2"></i>Đặt Lại Mật Khẩu
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="resetUserId" />
                <div class="modal-body py-4">
                    <p class="text-muted small">
                        Bạn đang đặt lại mật khẩu mới cho tài khoản: <strong class="text-primary fs-6" id="resetUsernameDisplay"></strong>
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Mật khẩu mới <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input type="password" name="newPassword" minlength="6" class="form-control bg-light border-start-0" placeholder="Nhập ít nhất 6 ký tự..." required />
                        </div>
                        <small class="text-muted mt-1 d-block">Mật khẩu sẽ được mã hóa bảo mật SHA256 trước khi lưu vào cơ sở dữ liệu.</small>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold text-dark">
                        <i class="fa-solid fa-arrow-rotate-right me-1"></i>Xác nhận đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================= -->
<!-- MODAL 3: XÁC NHẬN XÓA TÀI KHOẢN                              -->
<!-- ============================================================= -->
<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-danger" id="deleteUserModalLabel">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Xác Nhận Xóa Tài Khoản
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteUserId" />
                <div class="modal-body py-4">
                    <p class="text-secondary mb-2">
                        Bạn có chắc chắn muốn xóa tài khoản <strong class="text-danger" id="deleteUsernameDisplay"></strong> không?
                    </p>
                    <div class="alert alert-warning rounded-3 small mb-0">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> Hành động này không thể hoàn tác. Các tài khoản đã phát sinh đơn đặt phòng sẽ không thể xóa để bảo toàn dữ liệu thống kê.
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                        <i class="fa-solid fa-trash me-1"></i>Xóa vĩnh viễn
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Xử lý nạp dữ liệu vào modal Đặt lại mật khẩu
            const resetModal = document.getElementById('resetPasswordModal');
            if (resetModal) {
                resetModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const userId = button.getAttribute('data-user-id');
                    const username = button.getAttribute('data-username');
                    
                    document.getElementById('resetUserId').value = userId;
                    document.getElementById('resetUsernameDisplay').textContent = username;
                });
            }

            // Xử lý nạp dữ liệu vào modal Xóa người dùng
            const deleteModal = document.getElementById('deleteUserModal');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const userId = button.getAttribute('data-user-id');
                    const username = button.getAttribute('data-username');
                    
                    document.getElementById('deleteUserId').value = userId;
                    document.getElementById('deleteUsernameDisplay').textContent = username;
                });
            }
        });
    </script>
}
