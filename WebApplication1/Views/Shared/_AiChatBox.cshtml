<!-- ============================================================
     AI CHAT BOX T-BOOKING - GÓC DƯỚI BÊN PHẢI (BOTTOM-RIGHT)
     Hỗ trợ: Đặt phòng, Thiết bị, Thông tin phòng, Lịch trống theo giờ/số lượng.
     Tự động từ chối câu hỏi ngoài phạm vi.
============================================================ -->

<style>
    /* 1. NÚT KÍCH HOẠT CHAT (FLOATING ACTION BUTTON) */
    .tbooking-chat-fab {
        position: fixed;
        bottom: 25px;
        right: 25px;
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0d6efd 0%, #0052cc 100%);
