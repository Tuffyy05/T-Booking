        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        box-shadow: 0 10px 25px rgba(13, 110, 253, 0.35);
        cursor: pointer;
        z-index: 1050;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        border: 2px solid rgba(255, 255, 255, 0.4);
        outline: none;
    }

    .tbooking-chat-fab:hover {
        transform: scale(1.08) translateY(-3px);
        box-shadow: 0 14px 30px rgba(13, 110, 253, 0.5);
        color: #ffffff;
    }

    .tbooking-chat-fab:active {
        transform: scale(0.95);
    }

    /* Hiệu ứng vòng sóng lan tỏa (Pulse Wave) */
    .tbooking-chat-fab::before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        border: 2px solid #3b82f6;
        opacity: 0.8;
        animation: tbooking-pulse 2.2s infinite;
        z-index: -1;
    }

    @@keyframes tbooking-pulse {
        0% {
            transform: scale(1);
            opacity: 0.8;
        }
        70% {
            transform: scale(1.55);
            opacity: 0;
        }
        100% {
            transform: scale(1.65);
            opacity: 0;
        }
    }

    /* Badge gợi ý nổi bên cạnh nút */
    .tbooking-chat-badge-prompt {
