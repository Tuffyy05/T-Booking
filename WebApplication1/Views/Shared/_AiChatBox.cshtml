<!-- ============================================================
     JAVASCRIPT XỬ LÝ CHAT BOX
============================================================ -->
<script>
    (function () {
        let isChatOpen = false;
        let isWaitingResponse = false;

        // 1. Đóng/Mở chatbox
        window.tbookingToggleChat = function (forceState) {
            const chatWindow = document.getElementById("tbookingChatWindow");
            const fabIcon = document.getElementById("tbookingFabIcon");
            const promptBadge = document.getElementById("tbookingChatBadgePrompt");

            if (typeof forceState === "boolean") {
                isChatOpen = forceState;
            } else {
                isChatOpen = !isChatOpen;
            }

            if (isChatOpen) {
                chatWindow.classList.add("open");
                fabIcon.className = "fa-solid fa-xmark";
                if (promptBadge) promptBadge.style.display = "none";
                setTimeout(() => {
                    document.getElementById("tbookingChatInput")?.focus();
                }, 200);
            } else {
                chatWindow.classList.remove("open");
                fabIcon.className = "fa-solid fa-robot";
            }
        };

        // Đóng badge gợi ý nhỏ
        window.tbookingDismissBadge = function (event) {
            if (event) event.stopPropagation();
            const promptBadge = document.getElementById("tbookingChatBadgePrompt");
            if (promptBadge) promptBadge.style.display = "none";
        };

        // 2. Làm mới cuộc trò chuyện
        window.tbookingResetChat = function () {
            if (confirm("Bạn có muốn làm mới cuộc trò chuyện không?")) {
                const body = document.getElementById("tbookingChatBody");
                // Giữ lại welcome card và quick chips
                const welcomeCard = body.querySelector(".tbooking-welcome-card");
                const quickChips = document.getElementById("tbookingQuickChips");
                const typing = document.getElementById("tbookingTypingIndicator");

                body.innerHTML = "";
                if (welcomeCard) body.appendChild(welcomeCard);
                if (quickChips) body.appendChild(quickChips);
                if (typing) body.appendChild(typing);

                document.getElementById("tbookingChatInput").value = "";
                document.getElementById("tbookingChatInput").focus();
            }
        };

        // 3. Gửi câu hỏi từ chip gợi ý
        window.tbookingSendQuick = function (text) {
            if (!isChatOpen) {
                window.tbookingToggleChat(true);
            }
            const input = document.getElementById("tbookingChatInput");
            input.value = text;
            tbookingSendMessage(text);
        };

        // 4. Xử lý submit form
        window.tbookingHandleSubmit = function (event) {
            event.preventDefault();
            const input = document.getElementById("tbookingChatInput");
            const text = input.value.trim();
            if (text && !isWaitingResponse) {
                tbookingSendMessage(text);
                input.value = "";
            }
        };

        // 5. Hàm gửi tin nhắn và nhận phản hồi
        async function tbookingSendMessage(userText) {
            if (!userText || isWaitingResponse) return;

            // Render tin nhắn của User
            appendMessage(userText, "user");
            setWaiting(true);

            try {
                const response = await fetch("/Chat/Ask", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ message: userText })
                });

                if (!response.ok) {
                    throw new Error("Mã phản hồi lỗi: " + response.status);
                }

                const data = await response.json();
                setWaiting(false);

                if (data && data.reply) {
                    appendMessage(data.reply, "bot", data.quickSuggestions);
                } else {
                    appendMessage("Rất tiếc, tôi chưa nhận được câu trả lời từ máy chủ. Vui lòng thử lại!", "bot");
                }
            } catch (err) {
                console.error("Lỗi Chatbot:", err);
                setWaiting(false);
                appendMessage("⚠️ Đã xảy ra sự cố khi kết nối tới máy chủ. Vui lòng kiểm tra lại kết nối mạng hoặc thử lại sau!", "bot");
            }
        }

        // 6. Thêm bong bóng tin nhắn vào giao diện
        function appendMessage(text, sender, suggestions) {
            const body = document.getElementById("tbookingChatBody");
            const typing = document.getElementById("tbookingTypingIndicator");

            const msgDiv = document.createElement("div");
            msgDiv.className = `tbooking-message ${sender}`;

            // Avatar
            const avatarDiv = document.createElement("div");
            avatarDiv.className = "tbooking-msg-avatar";
            avatarDiv.innerHTML = sender === "user" ? '<i class="fa-solid fa-user"></i>' : '<i class="fa-solid fa-robot"></i>';

            // Content
            const contentDiv = document.createElement("div");
            contentDiv.className = "tbooking-msg-content";

            if (sender === "user") {
                contentDiv.innerText = text;
            } else {
                contentDiv.innerHTML = formatMarkdown(text);
            }

            msgDiv.appendChild(avatarDiv);
            msgDiv.appendChild(contentDiv);

            // Chèn trước typing indicator
            body.insertBefore(msgDiv, typing);

            // Nếu có gợi ý mới, thêm các chip phía dưới
            if (suggestions && suggestions.length > 0 && sender === "bot") {
                const chipsDiv = document.createElement("div");
                chipsDiv.className = "tbooking-quick-chips";
                suggestions.forEach(s => {
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = "tbooking-chip";
                    btn.innerText = s;
                    btn.onclick = () => tbookingSendQuick(s);
                    chipsDiv.appendChild(btn);
                });
                body.insertBefore(chipsDiv, typing);
            }

            // Cuộn xuống cuối
            scrollToBottom();
        }

        function setWaiting(waiting) {
            isWaitingResponse = waiting;
            const typing = document.getElementById("tbookingTypingIndicator");
            const sendBtn = document.getElementById("tbookingSendBtn");
            const input = document.getElementById("tbookingChatInput");

            if (waiting) {
                typing.classList.add("active");
                sendBtn.disabled = true;
                scrollToBottom();
            } else {
                typing.classList.remove("active");
                sendBtn.disabled = false;
                input.focus();
            }
        }

        function scrollToBottom() {
            const body = document.getElementById("tbookingChatBody");
            setTimeout(() => {
                body.scrollTop = body.scrollHeight;
            }, 50);
        }

        // Định dạng Markdown đơn giản (bold, italic, link)
        function formatMarkdown(text) {
            if (!text) return "";

            // Xử lý xuống dòng trước
            let html = text.replace(/\r\n/g, "\n");

            // Xử lý in đậm **text**
            html = html.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");

            // Xử lý in nghiêng *text*
            html = html.replace(/\*(.*?)\*/g, "<em>$1</em>");

            // Xử lý link markdown [title](url)
            html = html.replace(/\[(.*?)\]\((.*?)\)/g, function (match, title, url) {
                if (url.includes("/Bookings/Create")) {
                    return `<a href="${url}" class="btn-book-link"><i class="fa-regular fa-calendar-plus me-1"></i>${title}</a>`;
                }
                return `<a href="${url}" target="_blank" style="color: #0d6efd; font-weight: 600; text-decoration: underline;">${title}</a>`;
            });

            // Chuyển ký tự \n thành <br>
            html = html.replace(/\n/g, "<br>");

            return html;
        }

        // Tự động ẩn badge sau 15 giây nếu người dùng không bấm
        setTimeout(() => {
            const promptBadge = document.getElementById("tbookingChatBadgePrompt");
            if (promptBadge && !isChatOpen) {
                promptBadge.style.transition = "opacity 0.8s ease";
                promptBadge.style.opacity = "0";
                setTimeout(() => { promptBadge.style.display = "none"; }, 800);
            }
        }, 15000);
    })();
</script>
