@model IEnumerable<WebApplication1.Models.Facility>

@{
    ViewData["Title"] = "Quản lý thiết bị";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-tools"></i> Quản lý Trang thiết bị</h2>
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Thêm thiết bị mới</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Tên thiết bị</th>
                        <th>Mô tả / Thông số</th>
                        <th>Số lượng</th>
                        <th>Phòng trực thuộc</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Name</td>
                            <td>@item.Description</td>
                            <td><span class="badge bg-secondary">@item.Quantity</span></td>
                            <td>
                                @if (item.Room != null)
                                {
                                    <span class="badge bg-info text-dark">@item.Room.Name</span>
                                }
                                else
                                {
                                    <span class="text-muted">Kho chung / Tự do</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>