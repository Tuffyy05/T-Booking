@model IEnumerable<WebApplication1.Models.Facility>
@{
    ViewData["Title"] = "Quản lý Trang Thiết Bị";
    var totalCount = Model.Count();
    var roomAssignedCount = Model.Count(f => f.RoomId.HasValue);
    var sharedCount = Model.Count(f => !f.RoomId.HasValue);
}

<div class="container-fluid mt-2">
    <!-- TIÊU ĐỀ & NÚT THÊM MỚI -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                <i class="fa-solid fa-plug me-2"></i>Quản Lý Trang Thiết Bị
            </h3>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">
                Quản lý thiết bị máy chiếu, micro, máy tính theo từng phòng hoặc kho dùng chung.
            </p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-bold">
                <i class="fa-solid fa-plus me-2"></i>Thêm thiết bị mới
            </a>
        </div>
    </div>

    <!-- KHỐI THỐNG KÊ (STAT CARDS) -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%); border-left: 4px solid #0d6efd !important;">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: #dbeafe; color: #1d4ed8;">
                        <i class="fa-solid fa-plug-circle-check fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Tổng số mục thiết bị</span>
                        <h4 class="fw-bold text-dark mb-0 mt-1">@totalCount</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: linear-gradient(135deg, #ecfdf5 0%, #ffffff 100%); border-left: 4px solid #10b981 !important;">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: #d1fae5; color: #047857;">
                        <i class="fa-solid fa-door-open fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Đã gán theo phòng</span>
                        <h4 class="fw-bold text-success mb-0 mt-1">@roomAssignedCount</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: linear-gradient(135deg, #fffbeb 0%, #ffffff 100%); border-left: 4px solid #f59e0b !important;">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: #fef3c7; color: #b45309;">
                        <i class="fa-solid fa-boxes-stacked fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Kho dùng chung</span>
                        <h4 class="fw-bold text-warning mb-0 mt-1">@sharedCount</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH TRANG THIẾT BỊ -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark fs-6">
                <i class="fa-solid fa-list-check text-primary me-2"></i>Danh sách thiết bị (@totalCount)
            </span>
            <span class="badge bg-light text-secondary border rounded-pill px-3 py-2 small">
                Tự động kiểm soát chống trùng thiết bị trong cùng phòng
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3 text-uppercase fs-7 text-muted" style="width: 250px;">Tên thiết bị</th>
                            <th class="py-3 text-uppercase fs-7 text-muted">Mô tả / Thông số</th>
                            <th class="py-3 text-uppercase fs-7 text-muted text-center" style="width: 120px;">Số lượng</th>
                            <th class="py-3 text-uppercase fs-7 text-muted" style="width: 220px;">Phòng trực thuộc</th>
                            <th class="py-3 text-uppercase fs-7 text-muted text-center" style="width: 180px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fa-regular fa-folder-open fs-1 text-secondary opacity-50 mb-3 d-block"></i>
                                    Chưa có thiết bị nào trong hệ thống. Hãy nhấn "Thêm thiết bị mới" để bắt đầu!
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3 text-primary bg-primary bg-opacity-10" style="width: 38px; height: 38px;">
                                                <i class="fa-solid fa-laptop"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark fs-6">@item.Name</span>
                                                <small class="text-muted d-block">Mã: #@item.Id</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-secondary small">
                                            @(string.IsNullOrWhiteSpace(item.Description) ? "Không có mô tả" : item.Description)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2 fw-semibold">
                                            @item.Quantity
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.Room != null)
                                        {
                                            <span class="badge rounded-pill px-3 py-2 text-primary" style="background-color: #eff6ff; border: 1px solid #bfdbfe;">
                                                <i class="fa-solid fa-door-open me-1"></i>@item.Room.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill px-3 py-2 text-secondary" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                                <i class="fa-solid fa-boxes-stacked me-1"></i>Kho chung / Tự do
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-pill px-3 me-1 text-dark shadow-sm" title="Chỉnh sửa">
                                            <i class="fa-solid fa-pen text-warning me-1"></i>Sửa
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-pill px-3 text-dark shadow-sm" title="Xóa">
                                                <i class="fa-solid fa-trash text-danger me-1"></i>Xóa
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
