@model WebApplication1.Models.Facility

@{
    ViewData["Title"] = "Xóa thiết bị";
}

<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow border-danger">
        <div class="card-header bg-danger text-white">
            <h4>Xác Nhận Xóa Thiết Bị</h4>
        </div>
        <div class="card-body">
            <p class="text-danger fw-bold">Bạn có chắc chắn muốn xóa thiết bị này không?</p>
            <dl class="row">
                <dt class="col-sm-4">Tên thiết bị:</dt>
                <dd class="col-sm-8 fw-bold">@Model.Name</dd>

                <dt class="col-sm-4">Mô tả:</dt>
                <dd class="col-sm-8">@Model.Description</dd>

                <dt class="col-sm-4">Số lượng:</dt>
                <dd class="col-sm-8">@Model.Quantity</dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>