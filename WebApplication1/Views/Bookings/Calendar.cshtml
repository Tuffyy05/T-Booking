@{
    ViewData["Title"] = "Lịch Đặt Phòng - T-Booking Premium";
}

<style>
    /* Làm đẹp thẻ bọc ngoài lịch */
    .fc-theme-standard {
        background-color: #ffffff;
        border-radius: 20px;
        padding: 20px;
    }

    /* Đổi màu và font chữ thanh tiêu đề (Tháng/Năm) */
    .fc-toolbar-title {
        font-family: 'Plus Jakarta Sans', sans-serif !important;
        font-weight: 800 !important;
        color: #0f172a !important;
        font-size: 1.6rem !important;
        text-transform: capitalize;
        letter-spacing: -0.02em;
    }

    /* Tùy chỉnh các nút bấm trên lịch (Today, Prev, Next, Month...) */
    .fc-button-primary {
        background-color: #f1f5f9 !important;
        color: #334155 !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 12px !important;
        text-transform: capitalize !important;
        font-weight: 600 !important;
        font-size: 0.9rem !important;
        padding: 7px 16px !important;
        transition: all 0.2s ease-in-out;
        box-shadow: none !important;
    }

    .fc-button-primary:hover {
        background-color: #e0edff !important;
        color: #2563eb !important;
        border-color: #93c5fd !important;
        transform: translateY(-1px);
    }

    .fc-button-active, .fc-button-primary:active {
        background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%) !important;
        color: #ffffff !important;
        border-color: #1e40af !important;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3) !important;
    }

    /* Làm nhạt màu các đường kẻ lưới (Grid lines) */
    .fc-theme-standard td, .fc-theme-standard th, .fc-theme-standard .fc-scrollgrid {
        border-color: #f1f5f9 !important;
    }

    /* Tùy chỉnh phần tên ngày (Thứ 2, Thứ 3...) */
    .fc-col-header-cell-cushion {
        color: #475569;
        font-weight: 700;
        font-size: 0.88rem;
        padding: 12px 0 !important;
        text-decoration: none !important;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .fc-col-header-cell-cushion:hover {
        color: #2563eb;
    }

    /* Tô đậm phần "Ngày hôm nay" */
    .fc-day-today {
        background-color: rgba(37, 99, 235, 0.04) !important;
    }

    /* Trang trí các khối sự kiện (Events) */
    .fc-event {
        border: none !important;
        border-radius: 10px !important;
        padding: 4px 8px !important;
        font-size: 0.85rem !important;
        font-weight: 600;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.08);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .fc-event:hover {
        transform: scale(1.02) translateY(-1px);
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
        z-index: 10 !important;
    }

    /* Canh chỉnh thời gian ở cột bên trái */
    .fc-timegrid-axis-cushion, .fc-timegrid-slot-label-cushion {
        font-size: 0.82rem;
        color: #64748b;
        font-weight: 600;
    }
</style>

<div class="container-fluid px-lg-5 px-3 mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <span class="badge bg-light text-primary border border-primary px-3 py-2 rounded-pill font-heading fw-bold mb-2">
                GIÁM SÁT THỜI GIAN THỰC
            </span>
            <h3 class="fw-bold font-heading text-dark mb-1">
                Lịch Khả Dụng Toàn Hệ Thống
            </h3>
            <p class="text-muted small mb-0">Theo dõi lịch trình các phòng họp và phòng Lab đã được phê duyệt trực quan theo tuần và tháng.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-pill px-4">
                <i class="fa-solid fa-arrow-left me-1"></i> Trang chủ
            </a>
            <button type="button" onclick="tbookingToggleChat(true)" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm" style="background: linear-gradient(135deg, #2563eb, #1e40af);">
                <i class="fa-solid fa-wand-magic-sparkles text-warning me-1"></i> Hỏi AI giờ trống
            </button>
        </div>
    </div>

    <!-- Hộp cảnh báo nhắc nhở người dùng về giờ đã bị đặt -->
    <div class="alert shadow-sm border-0 mb-4 d-flex align-items-center" style="border-radius: 16px; background-color: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe;">
        <i class="fa-solid fa-circle-info fs-4 me-3 text-primary"></i>
        <div class="small fw-medium">
            Các khung giờ <strong class="text-danger">màu đỏ nhạt</strong> hiển thị trên lịch là những khung giờ <strong>đã được duyệt sử dụng</strong>. Quý khách vui lòng chọn các khung giờ còn trống khác để tránh bị trùng lịch.
        </div>
    </div>

    <!-- Nơi FullCalendar sẽ render (vẽ) lịch -->
    <div class="card shadow-sm border-0 p-2 rounded-4" style="border: 1px solid #e2e8f0; box-shadow: 0 15px 40px -10px rgba(15, 23, 42, 0.08) !important;">
        <div id='calendar'></div>
    </div>
</div>

@section Scripts {
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                buttonText: {
                    today: 'Hôm nay',
                    month: 'Tháng',
                    week: 'Tuần',
                    day: 'Ngày'
                },
                locale: 'vi',
                slotMinTime: '07:00:00',
                slotMaxTime: '22:00:00',
                allDaySlot: false,
                slotDuration: '00:30:00',
                expandRows: true,
                events: '/Bookings/GetEvents',
                eventClick: function(info) {
                    alert('KHUNG GIỜ NÀY ĐÃ CÓ NGƯỜI ĐẶT!\n\nPhòng: ' + info.event.title + '\nThời gian: ' +
                          info.event.start.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) + ' - ' +
                          info.event.end.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) +
                          '\nNgày: ' + info.event.start.toLocaleDateString('vi-VN'));
                }
            });

            calendar.render();
        });
    </script>
}
